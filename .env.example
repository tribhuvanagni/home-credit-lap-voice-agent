# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Understanding layer (optional).
# Without a key the deterministic rule extractor is used and the app still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=8000
# Set to 1 to force rule-based extraction even when a key is present.
LLM_DISABLED=

# Voice provider (optional). Without these the local simulation is used.
# See docs/voice-platform-status.md for the exact setup steps.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
RETELL_WEBHOOK_SECRET=
BOLNA_API_KEY=

# Call defaults
DEFAULT_COMPANY_NAME=Home Credit
DEFAULT_AGENT_NAME=Aarav
DEFAULT_AGENT_GENDER=male
DEFAULT_LANGUAGE=English
